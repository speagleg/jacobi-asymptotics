    z = (1.5 + 0.2j): g(-z) - g(z) = (0.0 - 3.14159265316j)   (expected -i pi = (0.0 - 3.14159265359j))
    z = (-0.7 + 1.1j): g(-z) - g(z) = (0.0 - 3.14159265316j)   (expected -i pi = (0.0 - 3.14159265359j))
    z = (3.0 + 0.5j): g(-z) - g(z) = (0.0 - 3.14159265316j)   (expected -i pi = (0.0 - 3.14159265359j))
